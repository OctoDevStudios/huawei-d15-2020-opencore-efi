<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ExitTimeOut</key>
	<integer>3</integer>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.hackintosh.gxfpd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/gxfp</string>
		<string>-v</string>
		<string>daemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/gxfpd.log</string>
	<key>StandardOutPath</key>
	<string>/var/log/gxfpd.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
</dict>
</plist>
